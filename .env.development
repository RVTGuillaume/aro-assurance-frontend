# ============================================
# CONFIGURATION DÉVELOPPEMENT LOCAL
# ARO Assurance - Frontend Vite + React
# ============================================

# ==========================================
# 🔥 API BACKEND
# ==========================================
# ⚠️ CORRECTION : Supprime `/api` de l'URL de base
# Axios ajoutera automatiquement `/api` dans les routes
VITE_API_URL=http://localhost:5000/api

# Environnement actuel
VITE_APP_ENV=development


# ==========================================
# 📋 APPLICATION CONFIG
# ==========================================
VITE_APP_NAME=ARO Assurance
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Plateforme de déclaration de sinistres


# ==========================================
# 📁 FILE UPLOAD
# ==========================================
# Taille maximale : 10 Mo (en bytes)
VITE_MAX_FILE_SIZE=10485760

# Types de fichiers autorisés
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Nombre maximal de fichiers par upload
VITE_MAX_FILES_PER_UPLOAD=5


# ==========================================
# 🔐 SÉCURITÉ
# ==========================================
# Durée de validité du token (en millisecondes)
VITE_TOKEN_EXPIRY=3600000

# Activer le mode strict HTTPS (false en dev)
VITE_FORCE_HTTPS=false


# ==========================================
# ⚙️ FEATURES / FONCTIONNALITÉS
# ==========================================
# Activer l'accès admin
VITE_ENABLE_ADMIN=true

# Activer les notifications
VITE_ENABLE_NOTIFICATIONS=true

# Activer le mode debug
VITE_ENABLE_DEBUG=true

# Activer les logs console
VITE_ENABLE_CONSOLE_LOGS=true


# ==========================================
# 🎨 UI / UX
# ==========================================
# Thème par défaut (light | dark)
VITE_DEFAULT_THEME=light

# Langue par défaut
VITE_DEFAULT_LANGUAGE=fr


# ==========================================
# 📊 PAGINATION
# ==========================================
# Nombre d'éléments par page
VITE_ITEMS_PER_PAGE=20

# Nombre max de pages à afficher
VITE_MAX_PAGINATION_PAGES=10
